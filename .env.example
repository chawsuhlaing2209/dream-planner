# Copy to .env.local. Never commit the real file.
# Local: a SQLite file. Hosted: libsql://<db>-<org>.turso.io plus DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/dream.db
DATABASE_AUTH_TOKEN=
# The shared family passcode.
APP_PASSCODE=
# A long random string (32+ characters) used to sign the login cookie.
# Make one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
